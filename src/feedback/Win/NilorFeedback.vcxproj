<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{AA7016F9-B94D-4D4A-8DEB-A042960BA70F}</ProjectGuid>
    <RootNamespace>NilorFeedback</RootNamespace>
    <ProjectName>NilorFeedback</ProjectName>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseOfMfc>false</UseOfMfc>
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(ProjectDir)$(IntDir)</OutDir>
    <IntDir>$(ProjectDir)obj\$(Configuration)\</IntDir>
    <TargetExt>.aex</TargetExt>
    <IgnoreImportLibrary>true</IgnoreImportLibrary>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(AeSdkDir)\Headers;$(AeSdkDir)\Headers\SP;$(AeSdkDir)\Headers\Win;$(AeSdkDir)\Resources;$(AeSdkDir)\Util;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32;_WINDOWS;MSWindows;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Configuration)'=='Debug'">_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Configuration)'=='Release'">NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebug</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreaded</RuntimeLibrary>
      <WarningLevel>Level3</WarningLevel>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <Link>
      <AdditionalDependencies>d3d12.lib;d3dcompiler.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <SubSystem>Windows</SubSystem>
    </Link>
    <ResourceCompile>
      <Culture>0x0409</Culture>
    </ResourceCompile>
  </ItemDefinitionGroup>

  <ItemGroup>
    <CustomBuild Include="..\FeedbackKernel.hlsl">
      <FileType>Document</FileType>
      <Command>if not exist "$(IntDir)DirectX_Assets" mkdir "$(IntDir)DirectX_Assets"
"$(DxcExe)" "%(FullPath)" -E main -Fo "$(IntDir)DirectX_Assets\FeedbackKernel.cso" -Frs "$(IntDir)DirectX_Assets\FeedbackKernel.rs" -T cs_6_5 -enable-16bit-types -ignore-line-directives</Command>
      <Message>Compiling %(Filename).hlsl with dxc</Message>
      <Outputs>$(IntDir)DirectX_Assets\FeedbackKernel.cso;$(IntDir)DirectX_Assets\FeedbackKernel.rs</Outputs>
    </CustomBuild>
  </ItemGroup>

  <ItemGroup>
    <CustomBuild Include="..\NilorFeedbackPiPL.r">
      <Command>cl /I "$(AeSdkDir)\Headers" /EP "..\NilorFeedbackPiPL.r" &gt; "$(IntDir)NilorFeedbackPiPL.rr"
"$(AeSdkDir)\Resources\PiPLtool" "$(IntDir)NilorFeedbackPiPL.rr" "$(IntDir)NilorFeedbackPiPL.rrc"
cl /D "MSWindows" /EP "$(IntDir)NilorFeedbackPiPL.rrc" &gt; "$(ProjectDir)NilorFeedbackPiPL.rc"</Command>
      <Message>Compiling the PiPL</Message>
      <Outputs>$(ProjectDir)NilorFeedbackPiPL.rc</Outputs>
    </CustomBuild>
  </ItemGroup>

  <ItemGroup>
    <ClCompile Include="$(AeSdkDir)\Util\DirectXUtils.cpp" />
    <ClCompile Include="$(AeSdkDir)\Util\Smart_Utils.cpp" />
    <ClCompile Include="..\NilorFeedback.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="NilorFeedbackPiPL.rc" />
  </ItemGroup>

  <Target Name="Ship" AfterTargets="Build">
    <MakeDir Directories="$(NilorDistDir)DirectX_Assets" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(NilorDistDir)" />
    <Copy SourceFiles="$(IntDir)DirectX_Assets\FeedbackKernel.cso;$(IntDir)DirectX_Assets\FeedbackKernel.rs" DestinationFolder="$(NilorDistDir)DirectX_Assets" Condition="'$(Configuration)'=='Release'" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AePluginsDir)" ContinueOnError="WarnAndContinue" Condition="'$(Configuration)'=='Release'" />
    <Copy SourceFiles="$(IntDir)DirectX_Assets\FeedbackKernel.cso;$(IntDir)DirectX_Assets\FeedbackKernel.rs" DestinationFolder="$(AePluginsDir)\DirectX_Assets" ContinueOnError="WarnAndContinue" Condition="'$(Configuration)'=='Release'" />
  </Target>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
